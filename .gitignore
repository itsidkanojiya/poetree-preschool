# Deployment artefacts
deploy-artifact/
*.pem
*.key

# Firebase service-account keys. These grant full admin on the Firebase project,
# and this repository is public - a stray git add -A must never sweep one in.
**/firebase-service-account.json
**/*firebase-adminsdk*.json
**/serviceAccountKey.json
# Android release signing: the upload keystore and the file holding its
# password. apps/mobile/android/.gitignore says the same; this catches a copy
# left anywhere else in the tree.
**/key.properties
*.jks
*.keystore
# Python bytecode from the content generators in scripts/content.
__pycache__/
*.pyc
