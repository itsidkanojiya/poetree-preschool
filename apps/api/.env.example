# ---------------------------------------------------------------------------
# Database
#
# MySQL runs on the shared Hostinger VPS. Open a tunnel for local development:
#
#   ssh -L 3306:localhost:3306 root@<vps-host>
#
# Use the poetree_preschool database and user — that user is granted on this
# schema only, so it cannot reach poetree_db, poetree_portal or nexus_publication.
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://poetree_preschool:CHANGE_ME@127.0.0.1:3306/poetree_preschool"

# ---------------------------------------------------------------------------
# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The two secrets MUST be different.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="CHANGE_ME_access"
JWT_REFRESH_SECRET="CHANGE_ME_refresh"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Server
#
# Port 4200, not 4000 — the shared VPS already serves api.poetreepublications.com
# on 4000. Ports 3000, 5000, 3100 and 4100 are taken by other projects too.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4200
# Comma-separated origins allowed to call the API with credentials.
# In production the portal calls the API server-side, so this is mainly for local work.
CORS_ORIGINS="http://localhost:3200"

# Reverse proxies in front of this process.
#   0 = reached directly on its port (current IP-only setup, and local dev)
#   1 = behind Nginx once school.poetreepublications.com is live
# Setting 1 with no proxy present lets anyone spoof X-Forwarded-For and bypass
# the login rate limiter, so only raise it when Nginx is actually in front.
TRUST_PROXY=0
# Seconds a school's plan status is cached in memory before it is re-read.
SCHOOL_STATUS_CACHE_TTL_SECONDS=60
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Seed — the bootstrap Super Admin created by `npm run db:seed`
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL="admin@poetree.com"
SEED_SUPER_ADMIN_PASSWORD="Poetree@2026"
