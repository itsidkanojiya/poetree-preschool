# ---------------------------------------------------------------------------
# Database
#
# MySQL lives on the Hostinger VPS and is bound to 127.0.0.1 there — it is never
# exposed publicly. For local development open an SSH tunnel first:
#
#   ssh -L 3307:127.0.0.1:3306 <vps-user>@<vps-host>
#
# ...then point DATABASE_URL at the local end of the tunnel.
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://poetree_dev:CHANGE_ME@127.0.0.1:3307/poetree_dev"

# ---------------------------------------------------------------------------
# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The two secrets MUST be different.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="CHANGE_ME_access"
JWT_REFRESH_SECRET="CHANGE_ME_refresh"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:3000"
# Seconds a school's plan status is cached in memory before it is re-read.
SCHOOL_STATUS_CACHE_TTL_SECONDS=60
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Seed — the bootstrap Super Admin created by `npm run db:seed`
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL="admin@poetree.com"
SEED_SUPER_ADMIN_PASSWORD="Poetree@2026"
