// Poetree Preschool Platform — Phase 1 schema.
//
// Multi-tenancy model: shared schema, one MySQL database, every tenant-owned
// table carries `schoolId`. Isolation is NOT enforced here — it is enforced
// centrally by the Prisma client extension in `src/db/prisma.ts`, which injects
// the school filter on every query against a model listed in TENANT_MODELS.
//
// The enums below mirror `packages/shared/src/enums.ts`. Change both together.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  PUBLICATION_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum ClassLevelCode {
  PLAY_GROUP
  NURSERY
  JUNIOR_KG
  SENIOR_KG
}

/// A student's state within ONE academic year. Because enrolment is per-year,
/// promoting a child never overwrites what they did last year.
enum EnrolmentStatus {
  ACTIVE
  PROMOTED
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

enum ClassroomTeacherRole {
  CLASS_TEACHER
  ASSISTANT
  SUBJECT_TEACHER
}

/// Deliberately short. Preschools do not need period-wise attendance or a reason
/// taxonomy, and every extra option costs a teacher time on the one screen they
/// use every single morning.
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
}

/// Each fee structure carries its own cadence, so a school can bill tuition
/// quarterly and an annual activity fee once without a second mechanism.
enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  CANCELLED
}

enum ConcessionKind {
  PERCENT
  FIXED
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  UPI
  CARD
  ONLINE
}

enum PaymentStatus {
  RECORDED
  CLEARED
  BOUNCED
  REFUNDED
}

/// The interactive activity types Poetree publishes. Content is authored once
/// at publication level and reused by every school.
enum ActivityType {
  TRACING
  MATCHING
  COUNTING
  FLASHCARD
  SORTING
  COLOURING
  RHYME
  STORY
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  COMPLETED
  NOT_COMPLETED
  LATE
}

enum NoticeType {
  GENERAL
  EVENT
  HOLIDAY
  ACADEMIC
  EMERGENCY
}

enum NoticeAudience {
  ALL
  TEACHERS
  PARENTS
  CLASSROOMS
}

enum ClassroomPostType {
  ANNOUNCEMENT
  MATERIAL
}

enum HolidayType {
  HOLIDAY
  VACATION
  EVENT
  WEEKLY_OFF
}

enum SequenceKind {
  ADMISSION
  RECEIPT
  INVOICE
}

enum FileVisibility {
  PRIVATE
  SCHOOL
  PUBLIC
}

enum StudentDocumentType {
  PHOTO
  BIRTH_CERTIFICATE
  ADDRESS_PROOF
  MEDICAL
  TRANSFER_CERTIFICATE
  OTHER
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationType {
  ATTENDANCE_ABSENT
  HOMEWORK_ASSIGNED
  HOMEWORK_REVIEWED
  FEE_DUE
  FEE_RECEIPT
  NOTICE_PUBLISHED
  NOTICE_EMERGENCY
  CLASSROOM_POST
  PROGRESS_UPDATED
  ACCOUNT_SECURITY
}

// ---------------------------------------------------------------------------
// Global / publication level — no schoolId, never tenant-filtered
// ---------------------------------------------------------------------------

model Publication {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(160)
  logoUrl   String?  @db.VarChar(500)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools School[]

  @@map("publications")
}

model School {
  id            String  @id @default(cuid())
  publicationId String
  name          String  @db.VarChar(160)
  /// Immutable. Doubles as the Android application-id segment in Phase 2
  /// (com.poetree.<code>), so it is restricted to [a-z][a-z0-9]{2,29}.
  code          String  @unique @db.VarChar(30)
  slug          String  @unique @db.VarChar(60)
  email         String? @db.VarChar(160)
  phone         String? @db.VarChar(20)
  addressLine1  String? @db.VarChar(200)
  addressLine2  String? @db.VarChar(200)
  city          String? @db.VarChar(100)
  state         String? @db.VarChar(100)
  postalCode    String? @db.VarChar(20)
  principalName String? @db.VarChar(120)
  /// A logo hosted elsewhere. Kept for schools that already had one.
  logoUrl       String? @db.VarChar(500)
  /// A logo uploaded through the portal. Preferred over logoUrl when both are
  /// set, and served publicly by school code — a sign-in screen has to be
  /// branded before anyone has signed in.
  logoFileId    String? @db.VarChar(191)
  primaryColor  String? @db.VarChar(7)

  /// The single switch that gates every user of this school. Only TRIAL and
  /// ACTIVE permit login; SUSPENDED and EXPIRED lock everyone out.
  status SchoolStatus @default(TRIAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publication              Publication               @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  logoFile                 FileObject?               @relation("SchoolLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  users                    User[]
  teacherProfiles          TeacherProfile[]
  parentProfiles           ParentProfile[]
  students                 Student[]
  studentGuardians         StudentGuardian[]
  studentEnrolments        StudentEnrolment[]
  studentDocuments         StudentDocument[]
  academicYears            AcademicYear[]
  classrooms               Classroom[]
  classroomTeachers        ClassroomTeacher[]
  subjects                 Subject[]
  rooms                    Room[]
  holidays                 SchoolHoliday[]
  sequences                DocumentSequence[]
  attendanceSessions       AttendanceSession[]
  attendanceRecords        AttendanceRecord[]
  feeHeads                 FeeHead[]
  feeStructures            FeeStructure[]
  feeStructureItems        FeeStructureItem[]
  feeConcessions           FeeConcession[]
  feeInvoices              FeeInvoice[]
  feeInvoiceLines          FeeInvoiceLine[]
  payments                 Payment[]
  paymentAllocations       PaymentAllocation[]
  activityAttempts         ActivityAttempt[]
  skillProgress            StudentSkillProgress[]
  timetablePeriods         TimetablePeriod[]
  timetableEntries         TimetableEntry[]
  homework                 Homework[]
  homeworkAttachments      HomeworkAttachment[]
  homeworkSubmissions      HomeworkSubmission[]
  homeworkSubmissionFiles  HomeworkSubmissionFile[]
  classroomPosts           ClassroomPost[]
  classroomPostAttachments ClassroomPostAttachment[]
  notices                  Notice[]
  noticeTargets            NoticeTarget[]
  noticeAttachments        NoticeAttachment[]
  noticeReads              NoticeRead[]
  files                    FileObject[]
  notifications            Notification[]
  deviceTokens             DeviceToken[]
  subscriptions            SchoolSubscription[]
  auditLogs                AuditLog[]

  @@index([publicationId])
  @@index([status])
  @@map("schools")
}

model SubscriptionPlan {
  id                  String  @id @default(cuid())
  code                String  @unique @db.VarChar(30)
  name                String  @db.VarChar(80)
  description         String? @db.Text
  /// null means unlimited
  maxStudents         Int?
  maxTeachers         Int?
  /// Smallest currency unit (paise) — never a float.
  priceInPaise        Int     @default(0)
  billingPeriodMonths Int     @default(12)
  features            Json    @default("[]")
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions SchoolSubscription[]

  @@map("subscription_plans")
}

/// One row per plan assignment. History is kept; `isCurrent` marks the live one.
/// Not tenant-filtered — only the Super Admin writes it, and the plan-status
/// middleware reads it system-side before any tenant context exists.
model SchoolSubscription {
  id       String @id @default(cuid())
  schoolId String
  planId   String

  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  expiresAt DateTime

  suspendedAt     DateTime?
  suspendedReason String?   @db.Text
  suspendedById   String?
  reactivatedAt   DateTime?
  reactivatedById String?

  isCurrent Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  suspendedBy   User?            @relation("SubscriptionSuspender", fields: [suspendedById], references: [id], onDelete: SetNull)
  reactivatedBy User?            @relation("SubscriptionReactivator", fields: [reactivatedById], references: [id], onDelete: SetNull)

  @@index([schoolId, isCurrent])
  @@index([planId])
  @@index([expiresAt])
  @@map("school_subscriptions")
}

/// The four preschool levels Poetree publishes for. Global so curriculum and
/// learning content can attach to a level in a later phase.
model ClassLevel {
  id           String         @id @default(cuid())
  code         ClassLevelCode @unique
  name         String         @db.VarChar(60)
  sortOrder    Int
  minAgeMonths Int?
  maxAgeMonths Int?

  classrooms    Classroom[]
  subjects      Subject[]
  feeStructures FeeStructure[]
  skills        Skill[]
  activities    LearningActivity[]

  @@map("class_levels")
}

// ---------------------------------------------------------------------------
// Tenant-owned — every model below carries schoolId and is auto-filtered
// ---------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  /// NULL only for PUBLICATION_ADMIN, who sits above every school.
  schoolId String?

  /// schoolId with NULL collapsed to the literal 'PUBLICATION'. Exists purely so
  /// the uniqueness constraints below hold for Super Admins too — MySQL treats
  /// NULLs as distinct, so a (schoolId, email) unique index would not stop two
  /// Super Admins sharing an email. Always written by the user service.
  scopeKey String @db.VarChar(32)

  name         String     @db.VarChar(120)
  email        String?    @db.VarChar(160)
  phone        String?    @db.VarChar(20)
  passwordHash String     @db.VarChar(72)
  role         Role
  status       UserStatus @default(ACTIVE)

  lastLoginAt        DateTime?
  mustChangePassword Boolean   @default(false)

  /// Soft delete. Staff who leave are deactivated, never removed — their name
  /// must still render on last year's attendance and homework.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school                   School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherProfile           TeacherProfile?
  parentProfile            ParentProfile?
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]           @relation("AuditActor")
  classroomAssignments     ClassroomTeacher[]
  markedAttendance         AttendanceSession[]  @relation("AttendanceMarker")
  correctedAttendance      AttendanceRecord[]   @relation("AttendanceUpdater")
  authoredHomework         Homework[]           @relation("HomeworkAuthor")
  reviewedSubmissions      HomeworkSubmission[] @relation("HomeworkReviewer")
  authoredPosts            ClassroomPost[]      @relation("ClassroomPostAuthor")
  authoredNotices          Notice[]             @relation("NoticeAuthor")
  approvedConcessions      FeeConcession[]      @relation("ConcessionApprover")
  recordedPayments         Payment[]            @relation("PaymentRecorder")
  timetableSlots           TimetableEntry[]     @relation("TimetableTeacher")
  noticeReads              NoticeRead[]
  uploadedFiles            FileObject[]         @relation("FileUploader")
  notifications            Notification[]
  deviceTokens             DeviceToken[]
  suspendedSubscriptions   SchoolSubscription[] @relation("SubscriptionSuspender")
  reactivatedSubscriptions SchoolSubscription[] @relation("SubscriptionReactivator")

  @@unique([scopeKey, email], name: "user_scope_email")
  @@unique([scopeKey, phone], name: "user_scope_phone")
  @@index([schoolId, role])
  @@index([schoolId, status])
  @@map("users")
}

model TeacherProfile {
  id       String @id @default(cuid())
  userId   String @unique
  schoolId String

  employeeCode  String?   @db.VarChar(40)
  qualification String?   @db.VarChar(160)
  joinedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, employeeCode])
  @@index([schoolId])
  @@map("teacher_profiles")
}

model ParentProfile {
  id       String @id @default(cuid())
  userId   String @unique
  schoolId String

  relation   GuardianRelation @default(GUARDIAN)
  occupation String?          @db.VarChar(120)
  address    String?          @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  children StudentGuardian[]

  @@index([schoolId])
  @@map("parent_profiles")
}

/// Students never hold credentials. They are reached through a guardian's
/// account — the parent taps an avatar in the Phase 2 app.
model Student {
  id       String @id @default(cuid())
  schoolId String

  /// Immutable, unique per school, issued from DocumentSequence. Also the key a
  /// returning child is matched on, so their history reconnects.
  admissionNo   String        @db.VarChar(40)
  admissionDate DateTime?
  firstName     String        @db.VarChar(60)
  lastName      String?       @db.VarChar(60)
  dateOfBirth   DateTime
  gender        Gender
  avatarUrl     String?       @db.VarChar(500)
  /// An uploaded photograph, preferred over avatarUrl. Never public: it is a
  /// picture of somebody's four-year-old and stays behind /files/:id.
  photoFileId   String?       @db.VarChar(191)
  bloodGroup    String?       @db.VarChar(8)
  status        StudentStatus @default(ACTIVE)

  addressLine1 String? @db.VarChar(200)
  addressLine2 String? @db.VarChar(200)
  city         String? @db.VarChar(100)
  postalCode   String? @db.VarChar(20)

  emergencyContactName  String? @db.VarChar(120)
  emergencyContactPhone String? @db.VarChar(20)
  /// Preschool duty of care: staff must be able to see this in seconds.
  allergies             String? @db.Text
  medicalNotes          String? @db.Text

  /// Soft delete only. Attendance, fees and history must remain reportable.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school              School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  photoFile           FileObject?            @relation("StudentPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  guardians           StudentGuardian[]
  enrolments          StudentEnrolment[]
  documents           StudentDocument[]
  attendanceRecords   AttendanceRecord[]
  homeworkSubmissions HomeworkSubmission[]
  activityAttempts    ActivityAttempt[]
  skillProgress       StudentSkillProgress[]
  feeConcessions      FeeConcession[]
  feeInvoices         FeeInvoice[]
  payments            Payment[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, status])
  @@index([schoolId, deletedAt])
  @@map("students")
}

/// One row per child PER ACADEMIC YEAR — the heart of the academic-year model.
///
/// Class and roll number live here rather than on Student, so promoting a child
/// closes one enrolment and opens another instead of overwriting history. A
/// student who repeats a level simply gets a second enrolment at the same level.
model StudentEnrolment {
  id             String @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String
  classroomId    String

  rollNo     String?         @db.VarChar(20)
  status     EnrolmentStatus @default(ACTIVE)
  enrolledOn DateTime        @default(now())
  exitedOn   DateTime?
  exitReason String?         @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classroom    Classroom    @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  /// A child can only be enrolled once in a given year.
  @@unique([studentId, academicYearId])
  @@index([schoolId, classroomId, status])
  @@index([schoolId, academicYearId, status])
  @@map("student_enrolments")
}

model StudentDocument {
  id        String @id @default(cuid())
  schoolId  String
  studentId String
  fileId    String

  type  StudentDocumentType @default(OTHER)
  label String?             @db.VarChar(120)

  createdAt DateTime @default(now())

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  file    FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId])
  @@map("student_documents")
}

/// Many-to-many: a student may have two guardians, a parent several children.
model StudentGuardian {
  id              String @id @default(cuid())
  schoolId        String
  studentId       String
  parentProfileId String

  relation           GuardianRelation @default(GUARDIAN)
  /// The default target for notifications about this child.
  isPrimary          Boolean          @default(false)
  /// Safeguarding: who may be called in an emergency, and who may collect the
  /// child at the gate. Not the same person in every family.
  isEmergencyContact Boolean          @default(false)
  canPickUp          Boolean          @default(true)

  createdAt DateTime @default(now())

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentProfile ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentProfileId])
  @@index([schoolId])
  @@index([parentProfileId])
  @@map("student_guardians")
}

/// Present in Phase 1 because attendance, fees and progress all hang off it
/// later, and retrofitting an academic year into existing data is painful.
model AcademicYear {
  id       String @id @default(cuid())
  schoolId String

  name      String   @db.VarChar(40)
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school             School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classrooms         Classroom[]
  enrolments         StudentEnrolment[]
  holidays           SchoolHoliday[]
  sequences          DocumentSequence[]
  attendanceSessions AttendanceSession[]
  homework           Homework[]
  skillProgress      StudentSkillProgress[]
  feeStructures      FeeStructure[]
  feeConcessions     FeeConcession[]
  feeInvoices        FeeInvoice[]
  timetablePeriods   TimetablePeriod[]
  timetableEntries   TimetableEntry[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

/// A class-level + section group of children within one academic year — "Nursery A".
///
/// Distinct from `Room` (a physical space, used by the timetable) and from the
/// class stream (`ClassroomPost`). The brief used one word for all three; this
/// schema keeps them separate.
model Classroom {
  id             String @id @default(cuid())
  schoolId       String
  academicYearId String
  classLevelId   String
  section        String @db.VarChar(40)
  capacity       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classLevel         ClassLevel          @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  /// Multiple staff per classroom: a class teacher, an assistant, and subject
  /// teachers all coexist without a schema change.
  teachers           ClassroomTeacher[]
  enrolments         StudentEnrolment[]
  attendanceSessions AttendanceSession[]
  homework           Homework[]
  posts              ClassroomPost[]
  timetableEntries   TimetableEntry[]
  noticeTargets      NoticeTarget[]

  @@unique([schoolId, academicYearId, classLevelId, section])
  @@index([schoolId])
  @@index([academicYearId])
  @@map("classrooms")
}

model ClassroomTeacher {
  id          String  @id @default(cuid())
  schoolId    String
  classroomId String
  userId      String
  subjectId   String?

  role      ClassroomTeacherRole @default(CLASS_TEACHER)
  startedOn DateTime             @default(now())
  endedOn   DateTime?

  createdAt DateTime @default(now())

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([classroomId, userId, subjectId])
  @@index([schoolId, userId])
  @@index([schoolId, classroomId])
  @@map("classroom_teachers")
}

/// Preschool "subjects" are activity areas — Language & Literacy, Numeracy,
/// Rhymes & Music. A NULL schoolId marks a publication-provided default that
/// every school inherits.
model Subject {
  id           String  @id @default(cuid())
  schoolId     String?
  classLevelId String?

  code      String  @db.VarChar(40)
  name      String  @db.VarChar(120)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School?            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classLevel       ClassLevel?        @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  classrooms       ClassroomTeacher[]
  homework         Homework[]
  timetableEntries TimetableEntry[]

  @@unique([schoolId, code])
  @@index([schoolId, isActive])
  @@map("subjects")
}

/// A physical space. Used by the timetable to detect double-booking; unrelated
/// to `Classroom`, which is a group of children.
model Room {
  id       String @id @default(cuid())
  schoolId String

  name     String @db.VarChar(80)
  capacity Int?

  createdAt DateTime @default(now())

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]

  @@unique([schoolId, name])
  @@map("rooms")
}

/// Non-teaching days. Without this, attendance prompts fire on holidays and
/// every attendance percentage is computed against the wrong denominator.
model SchoolHoliday {
  id             String @id @default(cuid())
  schoolId       String
  academicYearId String

  startDate DateTime
  endDate   DateTime
  title     String      @db.VarChar(120)
  type      HolidayType @default(HOLIDAY)

  createdAt DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([schoolId, startDate, endDate])
  @@map("school_holidays")
}

// ---------------------------------------------------------------------------
// Session & audit — keyed by user, not tenant-filtered
// ---------------------------------------------------------------------------

/// Refresh tokens are stored as a SHA-256 hash, rotated on every use, and
/// revoked in bulk when a school is suspended.
model RefreshToken {
  id     String @id @default(cuid())
  userId String

  tokenHash    String    @unique @db.VarChar(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedBy    String?   @db.VarChar(40)
  replacedById String?
  userAgent    String?   @db.VarChar(300)
  ipAddress    String?   @db.VarChar(64)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Written with the unscoped client so an audit entry can never be suppressed
/// by a tenant filter, and so publication-level events (which have no school)
/// can be recorded.
model AuditLog {
  id          String  @id @default(cuid())
  schoolId    String?
  actorUserId String?

  action   String  @db.VarChar(60)
  entity   String  @db.VarChar(60)
  entityId String? @db.VarChar(40)
  /// "Who changed what, from what, to what." Without before/after an audit log
  /// records that something happened but not what it did.
  before   Json?
  after    Json?
  metadata Json?

  requestId String? @db.VarChar(64)
  ipAddress String? @db.VarChar(64)

  createdAt DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

/// One row per classroom per day. The unique constraint on (classroomId, date)
/// is what makes duplicate attendance structurally impossible rather than a
/// validation somebody might forget to write.
model AttendanceSession {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  classroomId    String
  /// A calendar day, not an instant — DATE avoids timezone drift moving a
  /// register between days.
  date           DateTime @db.Date

  markedById String?
  markedAt   DateTime  @default(now())
  /// Set once the register is finalised; corrections then need a School Admin.
  lockedAt   DateTime?
  note       String?   @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classroom    Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  markedBy     User?              @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  records      AttendanceRecord[]

  @@unique([classroomId, date])
  @@index([schoolId, date])
  @@index([schoolId, academicYearId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String @id @default(cuid())
  schoolId  String
  sessionId String
  studentId String

  status      AttendanceStatus @default(PRESENT)
  remark      String?          @db.VarChar(200)
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedBy User?             @relation("AttendanceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([schoolId, studentId])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// Homework and the class stream
// ---------------------------------------------------------------------------

model Homework {
  id             String  @id @default(cuid())
  schoolId       String
  academicYearId String
  classroomId    String
  subjectId      String?

  title              String        @db.VarChar(160)
  description        String?       @db.Text
  assignedById       String
  assignedOn         DateTime      @default(now())
  dueDate            DateTime      @db.Date
  status             PublishStatus @default(DRAFT)
  /// When false the child simply does it at home; nothing is uploaded back.
  allowsSubmission   Boolean       @default(false)
  /// The ERP-to-LMS bridge: homework that IS an activity. Completion flows
  /// back from ActivityAttempt, so a parent never marks it done by hand.
  learningActivityId String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  school           School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classroom        Classroom            @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subject          Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  assignedBy       User                 @relation("HomeworkAuthor", fields: [assignedById], references: [id], onDelete: Restrict)
  learningActivity LearningActivity?    @relation(fields: [learningActivityId], references: [id], onDelete: SetNull)
  attachments      HomeworkAttachment[]
  submissions      HomeworkSubmission[]

  @@index([schoolId, classroomId, status])
  @@index([schoolId, dueDate])
  @@map("homework")
}

model HomeworkAttachment {
  id         String @id @default(cuid())
  schoolId   String
  homeworkId String
  fileId     String

  createdAt DateTime @default(now())

  school   School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  homework Homework   @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  file     FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([schoolId, homeworkId])
  @@map("homework_attachments")
}

/// Materialised for every enrolled child at publish time, so "who has not done
/// it" is an indexed lookup rather than a set difference computed per request.
model HomeworkSubmission {
  id         String @id @default(cuid())
  schoolId   String
  homeworkId String
  studentId  String

  status        SubmissionStatus @default(PENDING)
  submittedOn   DateTime?
  note          String?          @db.VarChar(500)
  teacherRemark String?          @db.VarChar(500)
  reviewedById  String?
  reviewedOn    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("HomeworkReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  files HomeworkSubmissionFile[]

  @@unique([homeworkId, studentId])
  @@index([schoolId, studentId, status])
  @@map("homework_submissions")
}

/// What a parent sent in — usually a photograph of the work, which is how a
/// preschool submission actually looks.
model HomeworkSubmissionFile {
  id           String @id @default(cuid())
  schoolId     String
  submissionId String
  fileId       String

  createdAt DateTime @default(now())

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submission HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  file       FileObject         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fileId])
  @@index([schoolId, submissionId])
  @@map("homework_submission_files")
}

/// The class stream: announcements and materials, newest first. Deliberately
/// thin - no comments, no reactions, no threads. This is not social media, and
/// moderating parent comments is a burden a small school cannot carry.
model ClassroomPost {
  id          String @id @default(cuid())
  schoolId    String
  classroomId String

  type        ClassroomPostType @default(ANNOUNCEMENT)
  title       String            @db.VarChar(160)
  body        String?           @db.Text
  createdById String
  status      PublishStatus     @default(PUBLISHED)
  publishedAt DateTime          @default(now())

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  school      School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroom   Classroom                 @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy   User                      @relation("ClassroomPostAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  attachments ClassroomPostAttachment[]

  @@index([schoolId, classroomId, publishedAt])
  @@map("classroom_posts")
}

model ClassroomPostAttachment {
  id       String @id @default(cuid())
  schoolId String
  postId   String
  fileId   String

  createdAt DateTime @default(now())

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  post   ClassroomPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  file   FileObject    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([schoolId, postId])
  @@map("classroom_post_attachments")
}

// ---------------------------------------------------------------------------
// Notices
// ---------------------------------------------------------------------------

model Notice {
  id       String @id @default(cuid())
  schoolId String

  title       String         @db.VarChar(160)
  body        String         @db.Text
  type        NoticeType     @default(GENERAL)
  audience    NoticeAudience @default(ALL)
  status      PublishStatus  @default(DRAFT)
  pinned      Boolean        @default(false)
  publishAt   DateTime       @default(now())
  expiresAt   DateTime?
  createdById String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("NoticeAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  targets     NoticeTarget[]
  attachments NoticeAttachment[]
  reads       NoticeRead[]

  @@index([schoolId, status, publishAt])
  @@map("notices")
}

model NoticeTarget {
  id          String @id @default(cuid())
  schoolId    String
  noticeId    String
  classroomId String

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  notice    Notice    @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([noticeId, classroomId])
  @@index([schoolId, classroomId])
  @@map("notice_targets")
}

model NoticeAttachment {
  id       String @id @default(cuid())
  schoolId String
  noticeId String
  fileId   String

  createdAt DateTime @default(now())

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  notice Notice     @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  file   FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([schoolId, noticeId])
  @@map("notice_attachments")
}

/// Per-user read receipts. For an emergency notice the useful question is not
/// "was it sent" but "who has not seen it".
model NoticeRead {
  id       String   @id @default(cuid())
  schoolId String
  noticeId String
  userId   String
  readAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([schoolId, userId])
  @@map("notice_reads")
}

// ---------------------------------------------------------------------------
// Fees
//
// Money is ALWAYS integer paise. Never a float, never a decimal string.
//
// Invoices rather than a running balance: a receipt must be reproducible years
// later exactly as issued, and a mutable balance cannot be audited. Indian
// schools are asked for old receipts constantly.
// ---------------------------------------------------------------------------

model FeeHead {
  id       String @id @default(cuid())
  schoolId String

  code     String  @db.VarChar(30)
  name     String  @db.VarChar(80)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items       FeeStructureItem[]
  concessions FeeConcession[]
  lines       FeeInvoiceLine[]

  @@unique([schoolId, code])
  @@map("fee_heads")
}

model FeeStructure {
  id             String @id @default(cuid())
  schoolId       String
  academicYearId String
  classLevelId   String

  name     String  @db.VarChar(80)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classLevel   ClassLevel         @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  items        FeeStructureItem[]

  /// One live structure per class level per year keeps "what does Nursery cost"
  /// a question with a single answer.
  @@unique([schoolId, academicYearId, classLevelId])
  @@map("fee_structures")
}

model FeeStructureItem {
  id             String @id @default(cuid())
  schoolId       String
  feeStructureId String
  feeHeadId      String

  amountInPaise Int
  frequency     FeeFrequency @default(ANNUAL)
  /// Day of month the instalment falls due; ignored for ONE_TIME.
  dueDayOfMonth Int          @default(10)

  createdAt DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@unique([feeStructureId, feeHeadId])
  @@index([schoolId])
  @@map("fee_structure_items")
}

/// The only sanctioned way one child pays less than another. Carries a reason
/// and an approver, so every rupee of difference is explainable in a dispute.
model FeeConcession {
  id             String  @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String
  feeHeadId      String?

  kind         ConcessionKind @default(PERCENT)
  /// Percent (0-100) or a fixed amount in paise, per `kind`.
  value        Int
  reason       String         @db.VarChar(200)
  approvedById String

  createdAt DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  feeHead      FeeHead?     @relation(fields: [feeHeadId], references: [id], onDelete: SetNull)
  approvedBy   User         @relation("ConcessionApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([schoolId, studentId, academicYearId])
  @@map("fee_concessions")
}

model FeeInvoice {
  id             String @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String

  invoiceNo   String @db.VarChar(40)
  /// "2026-07", "Q1", "Annual" - the billing window this invoice covers.
  periodLabel String @db.VarChar(40)

  issuedOn DateTime @default(now())
  dueDate  DateTime @db.Date

  grossInPaise    Int           @default(0)
  discountInPaise Int           @default(0)
  netInPaise      Int           @default(0)
  paidInPaise     Int           @default(0)
  status          InvoiceStatus @default(ISSUED)

  cancelledAt     DateTime?
  cancelledReason String?   @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  lines        FeeInvoiceLine[]
  allocations  PaymentAllocation[]

  /// Generation is idempotent on this key: re-running a month never
  /// double-charges a child.
  @@unique([studentId, academicYearId, periodLabel])
  @@unique([schoolId, invoiceNo])
  @@index([schoolId, status, dueDate])
  @@map("fee_invoices")
}

model FeeInvoiceLine {
  id        String @id @default(cuid())
  schoolId  String
  invoiceId String
  feeHeadId String

  description     String @db.VarChar(120)
  amountInPaise   Int
  discountInPaise Int    @default(0)

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHead FeeHead    @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@index([schoolId, invoiceId])
  @@map("fee_invoice_lines")
}

/// A payment is never edited or deleted. A refund is a second, negative
/// payment, so the trail of what actually happened stays intact.
model Payment {
  id        String @id @default(cuid())
  schoolId  String
  studentId String

  receiptNo     String        @db.VarChar(40)
  amountInPaise Int
  method        PaymentMethod @default(CASH)
  reference     String?       @db.VarChar(80)
  paidOn        DateTime      @db.Date
  note          String?       @db.VarChar(200)
  status        PaymentStatus @default(RECORDED)
  recordedById  String

  /// Populated only when a gateway is involved. Present from day one so adding
  /// Razorpay later needs no migration of live money data.
  provider          String? @db.VarChar(40)
  providerOrderId   String? @db.VarChar(80)
  providerPaymentId String? @db.VarChar(80)
  providerSignature String? @db.VarChar(200)

  createdAt DateTime @default(now())

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy  User                @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([schoolId, receiptNo])
  @@index([schoolId, studentId, paidOn])
  @@map("payments")
}

/// Splits one payment across invoices, which is what makes partial payment and
/// "pay two months at once" the same mechanism.
model PaymentAllocation {
  id        String @id @default(cuid())
  schoolId  String
  paymentId String
  invoiceId String

  amountInPaise Int

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([schoolId, invoiceId])
  @@map("payment_allocations")
}

// ---------------------------------------------------------------------------
// Timetable
// ---------------------------------------------------------------------------

model TimetablePeriod {
  id             String @id @default(cuid())
  schoolId       String
  academicYearId String

  name      String  @db.VarChar(40)
  startTime String  @db.VarChar(5)
  endTime   String  @db.VarChar(5)
  sortOrder Int     @default(0)
  /// Breaks appear on the grid but never carry a subject or a teacher.
  isBreak   Boolean @default(false)

  createdAt DateTime @default(now())

  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  entries      TimetableEntry[]

  @@unique([academicYearId, name])
  @@index([schoolId, academicYearId])
  @@map("timetable_periods")
}

/// One cell of the weekly grid.
///
/// The unique key stops a classroom being double-booked. The two conflicts a
/// database cannot express - the same teacher or the same room in two places at
/// once - are enforced in the service and covered by tests.
model TimetableEntry {
  id             String @id @default(cuid())
  schoolId       String
  academicYearId String
  classroomId    String
  periodId       String

  /// 1 = Monday through 7 = Sunday.
  dayOfWeek Int
  subjectId String?
  teacherId String?
  roomId    String?
  note      String? @db.VarChar(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classroom    Classroom       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  period       TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subject      Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher      User?           @relation("TimetableTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  room         Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([classroomId, dayOfWeek, periodId])
  @@index([schoolId, teacherId, dayOfWeek])
  @@index([schoolId, roomId, dayOfWeek])
  @@map("timetable_entries")
}

// ---------------------------------------------------------------------------
// Learning content and progress
//
// Skills and activities are publication-owned (no schoolId) — Poetree authors
// them once and every school reads the same set. Attempts and progress are
// tenant data, because they are about a particular child.
// ---------------------------------------------------------------------------

/// A thing a child is learning, e.g. "Letter recognition A-Z".
///
/// Progress is measured against these rather than against activities, so
/// replacing an activity does not lose a child's history.
model Skill {
  id           String  @id @default(cuid())
  code         String  @unique @db.VarChar(40)
  name         String  @db.VarChar(120)
  classLevelId String?
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classLevel ClassLevel?            @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  activities LearningActivity[]
  progress   StudentSkillProgress[]

  @@index([classLevelId, sortOrder])
  @@map("skills")
}

model LearningActivity {
  id           String       @id @default(cuid())
  code         String       @unique @db.VarChar(40)
  title        String       @db.VarChar(160)
  type         ActivityType
  skillId      String
  classLevelId String?
  /// The activity definition the app renders — letters to trace, pairs to
  /// match. Shape varies by type, which is why it is JSON rather than columns.
  contentJson  Json?
  isActive     Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skill      Skill             @relation(fields: [skillId], references: [id], onDelete: Restrict)
  classLevel ClassLevel?       @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  attempts   ActivityAttempt[]
  homework   Homework[]

  @@index([skillId])
  @@index([classLevelId, isActive])
  @@map("learning_activities")
}

/// One go at an activity. The source of truth for everything below it.
model ActivityAttempt {
  id         String @id @default(cuid())
  schoolId   String
  studentId  String
  activityId String

  correctCount     Int
  totalCount       Int
  timeSpentSeconds Int       @default(0)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  /// Per-question detail, so a teacher can see which letters were missed.
  resultJson       Json?

  createdAt DateTime @default(now())

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activity LearningActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([schoolId, studentId, createdAt])
  @@index([schoolId, activityId])
  @@map("activity_attempts")
}

/// A rollup of attempts, kept so a progress screen is one indexed read rather
/// than a scan of every attempt a child has ever made. Rebuildable from
/// ActivityAttempt, which remains authoritative.
model StudentSkillProgress {
  id             String @id @default(cuid())
  schoolId       String
  studentId      String
  skillId        String
  academicYearId String

  /// Correct answers as a percentage of questions answered, over the child's
  /// most recent attempts at this skill. Stored alongside the counts it came
  /// from so the figure can always be explained to a parent.
  masteryPercent Int      @default(0)
  correctCount   Int      @default(0)
  totalCount     Int      @default(0)
  attemptsCount  Int      @default(0)
  lastAssessedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId, academicYearId])
  @@index([schoolId, studentId])
  @@map("student_skill_progress")
}

// ---------------------------------------------------------------------------
// Cross-cutting infrastructure
// ---------------------------------------------------------------------------

/// Gapless per-school counters for admission numbers, receipts and invoices.
///
/// Allocation happens inside the same transaction as the document it numbers,
/// with a row lock. Never MAX(number)+1 — that races, and two clerks taking fees
/// at once would issue the same receipt number.
model DocumentSequence {
  id             String  @id @default(cuid())
  schoolId       String
  academicYearId String?

  kind       SequenceKind
  prefix     String       @default("") @db.VarChar(16)
  nextNumber Int          @default(1)

  updatedAt DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([schoolId, kind, academicYearId])
  @@map("document_sequences")
}

/// Metadata only — bytes live on disk (or object storage later), never in MySQL.
///
/// Private by default: the API authorises the request and then hands off to
/// Nginx via X-Accel-Redirect, so guessing a URL yields nothing.
model FileObject {
  id       String  @id @default(cuid())
  /// NULL for publication-owned content shared across every school.
  schoolId String?

  /// Path within the storage root. Generated UUID — a user-supplied filename
  /// never reaches the filesystem.
  storageKey   String         @unique @db.VarChar(300)
  originalName String         @db.VarChar(255)
  mimeType     String         @db.VarChar(120)
  sizeBytes    Int
  checksum     String?        @db.VarChar(64)
  visibility   FileVisibility @default(PRIVATE)
  uploadedById String?

  /// Soft delete; a job purges the bytes after a grace period so a misclick is
  /// recoverable.
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  school                   School?                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  brandedSchools           School[]                  @relation("SchoolLogo")
  studentPhotos            Student[]                 @relation("StudentPhoto")
  uploadedBy               User?                     @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  documents                StudentDocument[]
  homeworkAttachments      HomeworkAttachment[]
  submissionFiles          HomeworkSubmissionFile[]
  classroomPostAttachments ClassroomPostAttachment[]
  noticeAttachments        NoticeAttachment[]

  @@index([schoolId, deletedAt])
  @@map("file_objects")
}

/// The durable in-app inbox. Writing this row and sending the push are separate
/// steps, so a failed push never loses the message.
model Notification {
  id       String @id @default(cuid())
  schoolId String
  userId   String

  type       NotificationType
  title      String           @db.VarChar(160)
  body       String           @db.Text
  /// Deep-link payload for the app.
  data       Json?
  entityType String?          @db.VarChar(60)
  entityId   String?          @db.VarChar(40)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId, readAt])
  @@index([schoolId, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id       String @id @default(cuid())
  schoolId String
  userId   String

  token      String         @unique @db.VarChar(255)
  platform   DevicePlatform
  appVersion String?        @db.VarChar(40)
  lastSeenAt DateTime       @default(now())
  /// Revoked on sign-out, and pruned when FCM reports the token stale.
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId, revokedAt])
  @@map("device_tokens")
}
