#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# The Poetree Kids Firebase app's config. It identifies the Firebase project
# and is kept out of this public repository; put it in place on the machine
# that builds releases.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Per-school build inputs. sunrise.example.json is the template and is tracked.
schools/*.json
!schools/*.example.json
