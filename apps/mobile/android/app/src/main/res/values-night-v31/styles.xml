<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later, Dark Mode on: the system draws its own splash,
         the app icon on a plain colour, before the app's. That colour is the
         splash's sky, so the system splash leads into the app's. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_sky</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
