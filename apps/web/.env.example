# Server-side base URL the portal uses to reach the API.
# Local development: the API on port 4000.
# On the VPS both run behind Nginx, so this becomes https://api.<domain>/api/v1
API_BASE_URL="http://127.0.0.1:4000/api/v1"

# Set to 1 in production so auth cookies are marked Secure.
COOKIE_SECURE=0
