# Server-side base URL the portal uses to reach the API.
#
# Port 4200 because the shared VPS already runs another API on 4000.
# In production this stays on 127.0.0.1 — the portal talks to the API inside the
# box, and only Nginx is public.
API_BASE_URL="http://127.0.0.1:4200/api/v1"

# Set to 1 in production so auth cookies are marked Secure. Leave 0 for local
# http://localhost work, or the browser will silently drop the session cookie.
COOKIE_SECURE=0
